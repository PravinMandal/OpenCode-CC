#!/usr/bin/env bash
# claude-t3: Claude Code launcher for T3 Code.
#
# One job: make the local model (local/*) fit inside its small window.
#
# LFM3 runs on CPU with a 16k window, so it gets a four-tool surface, a short
# system prompt, low effort and a 16k context hint.
#
# Everything else -- paid (cx/*, ag/*) and free (oc/*) -- is exec'd untouched.
# Free models do not need help here: the opencode-cc sidecar replaces the client
# tool surface with the 13 canonical OpenCode tools and translates each call
# back to the client's own tool name and arguments, so shaping here would only
# duplicate the proxy. Measured on this machine on 2026-11-02: the stock CLI
# surface goes in, the sidecar sends canonical-only, and Bash/Skill/Read/Edit
# turns all succeed.
#
# This launcher only rewrites client-side arguments. It never handles traffic.
set -euo pipefail

REAL="${CLAUDE_T3_REAL:-$HOME/.local/share/mise/installs/claude/latest/claude}"
if [ ! -x "$REAL" ]; then
  REAL="$(command -v claude || true)"
fi
if [ -z "$REAL" ] || [ ! -x "$REAL" ]; then
  echo "claude-t3: real claude binary not found" >&2
  exit 127
fi

LEAN_LOCAL="${CLAUDE_T3_LOCAL_TOOLS:-Bash,Read,Write,Edit}"
LOCAL_CONTEXT="${CLAUDE_T3_LOCAL_CONTEXT:-16384}"
LOCAL_PROMPT="${CLAUDE_T3_LOCAL_PROMPT:-You are a concise coding agent running locally on this machine. Use the available tools to inspect, edit, and run code. Keep replies short and do not dump large files because the context window is small.}"

model=""
args=("$@")
i=0
while [ "$i" -lt "${#args[@]}" ]; do
  case "${args[$i]}" in
    --model) model="${args[$((i + 1))]:-}" ;;
    --model=*) model="${args[$i]#--model=}" ;;
  esac
  i=$((i + 1))
done
[ -n "$model" ] || model="${ANTHROPIC_MODEL:-}"

case "$model" in
  local/*) ;;
  *) exec "$REAL" "$@" ;;
esac

out=()
seen_tools=0
seen_effort=0
seen_system=0
i=0
while [ "$i" -lt "${#args[@]}" ]; do
  case "${args[$i]}" in
    --tools)
      out+=(--tools "$LEAN_LOCAL")
      i=$((i + 2))
      seen_tools=1
      ;;
    --tools=*)
      out+=(--tools "$LEAN_LOCAL")
      i=$((i + 1))
      seen_tools=1
      ;;
    --effort)
      # LFM3 only advertises a low effort level, and T3's default is high.
      out+=(--effort low)
      i=$((i + 2))
      seen_effort=1
      ;;
    --effort=*)
      out+=(--effort low)
      i=$((i + 1))
      seen_effort=1
      ;;
    --system-prompt|--system-prompt=*|--append-system-prompt|--append-system-prompt=*)
      seen_system=1
      out+=("${args[$i]}")
      i=$((i + 1))
      ;;
    *)
      out+=("${args[$i]}")
      i=$((i + 1))
      ;;
  esac
done
[ "$seen_tools" -eq 1 ] || out+=(--tools "$LEAN_LOCAL")
[ "$seen_effort" -eq 1 ] || out+=(--effort low)
# T3 does not pass a command-line system prompt; replacing the large default
# preset is what keeps a 16k local model inside its window.
[ "$seen_system" -eq 1 ] || out+=(--system-prompt "$LOCAL_PROMPT")
export CLAUDE_CODE_MAX_CONTEXT_TOKENS="$LOCAL_CONTEXT"

# One line per shaped launch, so a future regression is visible without
# turning on Claude Code debug logs.
LOG="${XDG_STATE_HOME:-$HOME/.local/state}/claude-t3/launch.log"
mkdir -p "$(dirname "$LOG")"
printf '%s model=%s mode=local tools=%s\n' "$(date -Is)" "$model" "$LEAN_LOCAL" >>"$LOG"

exec "$REAL" "${out[@]}"
